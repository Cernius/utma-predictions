# Firebase Realtime Database — copy to .env.local for local dev, and add the same
# values as repository secrets (Settings → Secrets and variables → Actions) so the
# GitHub Pages build can inline them. All values are public by design; access is
# controlled by the database rules, not by secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
